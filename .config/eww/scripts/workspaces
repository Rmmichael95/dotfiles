#!/bin/env zsh

icons=("󱂈" "󱂉" "󱂊" "󱂋" "󱂌" "󱂍" "󱂎" "󱂏" "󱂐" "󱂑")

workspaces() {
    local ws_json active_id
    ws_json=$(hyprctl workspaces -j)
    active_id=$(hyprctl activeworkspace -j | jq '.id')

    local out="(box :class \"works\" :orientation \"h\" :spacing 8 :space-evenly \"false\""

    for i in $(seq 1 10); do
        local exists
        exists=$(echo "$ws_json" | jq "map(select(.id == $i)) | length")
        [ "$exists" -eq 0 ] && continue

        local class="o"
        [ "$active_id" -eq "$i" ] && class="of"

        out+=" (button :onclick \"hyprctl dispatch workspace $i\" :class \"$class\" \"${icons[$i]}\")"
    done

    out+=")"
    echo "$out"
}

# Derive socket path at runtime — HYPRLAND_INSTANCE_SIGNATURE is set by Hyprland
# and imported by UWSM into the systemd user manager, but the eww daemon may
# have inherited a stale or empty environment depending on activation ordering.
# Resolve it directly from the filesystem as a reliable fallback.
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPRLAND_INSTANCE_SIGNATURE=$(ls "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)
fi
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

workspaces
socat -u "UNIX-CONNECT:$SOCKET" - | while read -r line; do
    case "$line" in
        workspace\>\>* | focusedmon\>\>*)
            workspaces ;;
    esac
done
