#!/bin/env sh
# Toggle a bar popup window with mutual exclusion.
# Uses eww's own window state — no lockfiles.

CFG="$HOME/.config/eww/bar"
TARGET="$1"
POPUPS="calendar system music_win audio_ctl"

if eww --config "$CFG" windows | grep -q "^▶ ${TARGET}$"; then
    eww --config "$CFG" close $POPUPS
else
    eww --config "$CFG" close $POPUPS
    eww --config "$CFG" open "$TARGET"
fi
