#!/bin/env sh

icons=("󱂈" "󱂉" "󱂊" "󱂋" "󱂌" "󱂍" "󱂎" "󱂏" "󱂐" "󱂑")

workspaces() {
    local ws_json active_id
    ws_json=$(hyprctl workspaces -j)
    active_id=$(hyprctl activeworkspace -j | jq '.id')

    local out="(box :class \"works\" :orientation \"h\" :spacing 8 :space-evenly \"false\""

    for i in $(seq 1 10); do
        local exists
        exists=$(echo "$ws_json" | jq "map(select(.id == $i)) | length")
        [ "$exists" -eq 0 ] && continue

        local class="o"
        [ "$active_id" -eq "$i" ] && class="of"

        out+=" (button :onclick \"hyprctl dispatch workspace $i\" :class \"$class\" \"${icons[$((i-1))]}\")"
    done

    out+=")"
    echo "$out"
}

workspaces
socat -u "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" - \
    | while IFS="\n" read -r line; do
        [ "workspace>>" = "$(echo "$line" | cut -c1-11)" ] && workspaces
    done
