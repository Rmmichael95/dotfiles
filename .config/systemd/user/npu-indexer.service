[Unit]
Description=NPU Semantic Note Indexer (inotify)
Requires=flm.service
After=flm.service

[Service]
Type=simple
ExecStart=%h/.local/bin/myBin/npu/npu-note-indexer
Restart=always
RestartSec=5

# Security & Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/cache/npu_vectors

[Install]
WantedBy=default.target
