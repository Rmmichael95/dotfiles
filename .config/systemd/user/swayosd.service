# ~/.config/systemd/user/swayosd.service
#
# SwayOSD visual feedback server.
# Displays OSD overlays for volume, brightness, and input indicators.
#
# Install:
#   cp swayosd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now swayosd.service
#
# Remove the exec-once line from hyprland.conf once this is enabled.
# Verify: systemctl --user status swayosd

[Unit]
Description=SwayOSD Visual Feedback Server
Documentation=https://github.com/ErikReider/SwayOSD
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=swayosd-server --style %h/.config/swayosd/style.css
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical-session.target
