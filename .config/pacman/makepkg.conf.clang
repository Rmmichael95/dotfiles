#!/hint/bash
#
# /etc/makepkg.conf
#
# Aggressive Clang/LLVM ThinLTO profile for CachyOS znver4-capable systems.
#
# Recommended install location for local testing:
#   ~/.config/pacman/makepkg.conf
#
# System-wide location:
#   /etc/makepkg.conf
#

#########################################################################
# SOURCE ACQUISITION
#########################################################################
#
#-- The download utilities that makepkg should use to acquire sources
#  Format: 'protocol::agent'
DLAGENTS=('file::/usr/bin/curl -qgC - -o %o %u'
    'ftp::/usr/bin/curl -qgfC - --ftp-pasv --retry 3 --retry-delay 3 -o %o %u'
    'http::/usr/bin/curl -qgb "" -fLC - --retry 3 --retry-delay 3 -o %o %u'
    'https::/usr/bin/curl -qgb "" -fLC - --retry 3 --retry-delay 3 -o %o %u'
    'rsync::/usr/bin/rsync --no-motd -z %u %o'
    'scp::/usr/bin/scp -C %u %o')

# Other common tools:
# /usr/bin/snarf
# /usr/bin/lftpget -c
# /usr/bin/wget

#-- The package required by makepkg to download VCS sources
#  Format: 'protocol::package'
VCSCLIENTS=('bzr::bzr'
    'fossil::fossil'
    'git::git'
    'hg::mercurial'
    'svn::subversion')

#########################################################################
# ARCHITECTURE, COMPILE FLAGS
#########################################################################
#
CARCH="x86_64"
CHOST="x86_64-pc-linux-gnu"

#########################################################################
# LLVM / CLANG TOOLCHAIN
#########################################################################
#
# Clang-first build chain. This is more aggressive than the normal Arch/GCC
# default and may require package-specific fallback for some AUR packages.
#
export CC="clang"
export CXX="clang++"

# LLVM archive/binutils helpers.
# These make the toolchain more coherent when building with Clang + LTO.
export AR="llvm-ar"
export NM="llvm-nm"
export RANLIB="llvm-ranlib"
export OBJCOPY="llvm-objcopy"
export STRIP="llvm-strip"

#########################################################################
# PARALLELISM
#########################################################################
#
# Use all logical cores for aggressive builds.
# If the system becomes too hot or unresponsive, change to:
#   _jobs="$(nproc --ignore=1)"
#
_jobs="$(nproc)"
_load="$((_jobs - 1))"

if (( _load < 1 )); then
    _load=1
fi

# makepkg/pacman variable. Newer makepkg also understands NPROC.
NPROC="${_jobs}"

# Build-system-specific parallel flags.
MAKEFLAGS="-j${_jobs} -l${_load}"
NINJAFLAGS="-j${_jobs}"
export CMAKE_BUILD_PARALLEL_LEVEL="${_jobs}"

#########################################################################
# COMPILER AND LINKER FLAGS
#########################################################################
#
# Aggressive native CPU optimization for this machine.
#
# -march=native:
#   Build specifically for your CPU. Good for local AUR packages on this box.
#
# -O3:
#   Aggressive runtime optimization. Can increase binary size and compile time.
#
# -pipe:
#   Use pipes instead of temporary files during compilation.
#
# -fno-plt:
#   Avoid PLT indirection where possible.
#
# _FORTIFY_SOURCE=3:
#   Stronger libc fortification than level 2 on modern glibc/toolchains.
#
# NOTE:
#   For maximum runtime speed, this profile intentionally does NOT include:
#     -fno-omit-frame-pointer
#     -mno-omit-leaf-frame-pointer
#     -Wp,-D_GLIBCXX_ASSERTIONS
#
#   Those improve debugging/profiling/safety, but are not the fastest runtime
#   profile.
#
#CPPFLAGS=""
CFLAGS="-march=native -O3 -pipe -fno-plt -fexceptions \
        -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security \
        -fstack-clash-protection -fcf-protection"

CXXFLAGS="$CFLAGS"

#########################################################################
# LINKER FLAGS
#########################################################################
#
# Clang + ThinLTO is most coherent with lld.
#
# IMPORTANT:
#   -fuse-ld=lld belongs outside the -Wl list.
#   Do NOT write it as:
#     -Wl,...,-fuse-ld=lld
#
# ThinLTO cache:
#   Speeds repeated local rebuilds.
#
LDFLAGS="-fuse-ld=lld \
         -Wl,-O2 \
         -Wl,--as-needed \
         -Wl,-z,relro \
         -Wl,-z,now \
         -Wl,-z,pack-relative-relocs \
         -Wl,--thinlto-jobs=${_jobs} \
         -Wl,--thinlto-cache-dir=/tmp/thinlto \
         -Wl,--thinlto-cache-policy=cache_size_bytes=20g"

#########################################################################
# LINK TIME OPTIMIZATION
#########################################################################
#
# Clang's scalable LTO mode.
#
# makepkg's lto option appends LTOFLAGS to CFLAGS, CXXFLAGS, and LDFLAGS.
# Clang's ThinLTO uses -flto=thin and can parallelize backend work through
# supported linkers such as lld.
#
LTOFLAGS="-flto=thin"

#########################################################################
# RUST FLAGS
#########################################################################
#
# Aggressive Rust profile:
#
# -C target-cpu=native:
#   Native CPU tuning.
#
# -C codegen-units=1:
#   Better optimization potential, slower compile.
#
# -C lto=thin:
#   ThinLTO for Rust.
#
# lld linker:
#   Keep Rust aligned with the Clang/lld profile.
#
RUSTFLAGS="-C opt-level=3 \
           -C target-cpu=native \
           -C codegen-units=1 \
           -C lto=thin \
           -C link-arg=-fuse-ld=lld"

#########################################################################
# DEBUGGING FLAGS
#########################################################################
#
DEBUG_CFLAGS="-g"
DEBUG_CXXFLAGS="$DEBUG_CFLAGS"
#DEBUG_RUSTFLAGS="-C debuginfo=2"

#########################################################################
# BUILD ENVIRONMENT
#########################################################################
#
# Makepkg defaults: BUILDENV=(!distcc !color !ccache check !sign)
#  A negated environment option will do the opposite of the comments below.
#
#-- distcc:   Use the Distributed C/C++/ObjC compiler
#-- color:    Colorize output messages
#-- ccache:   Use ccache to cache compilation
#-- check:    Run the check() function if present in the PKGBUILD
#-- sign:     Generate PGP signature file
#
# For fastest local package builds, this profile disables check().
# If you prefer validation over speed, change !check to check.
#
BUILDENV=(!distcc color ccache !check !sign)
#
#-- If using DistCC, your MAKEFLAGS will also need modification. In addition,
#-- specify a space-delimited list of hosts running in the DistCC cluster.
#DISTCC_HOSTS=""
#
#-- Specify a directory for package building.
#
# /tmp can be faster if tmpfs-backed, but large AUR packages can exhaust RAM.
# For a stable high-performance workstation, use SSD/NVMe-backed cache.
#
BUILDDIR=/tmp/makepkg
# BUILDDIR="${XDG_CACHE_HOME}/makepkg/build"

#########################################################################
# GLOBAL PACKAGE OPTIONS
#   These are default values for the options=() settings
#########################################################################
#
# Makepkg defaults may vary by pacman version.
#  A negated option will do the opposite of the comments below.
#
#-- strip:      Strip symbols from binaries/libraries
#-- docs:       Save doc directories specified by DOC_DIRS
#-- libtool:    Leave libtool (.la) files in packages
#-- staticlibs: Leave static library (.a) files in packages
#-- emptydirs:  Leave empty directories in packages
#-- zipman:     Compress manual (man and info) pages in MAN_DIRS with gzip
#-- purge:      Remove files specified by PURGE_TARGETS
#-- debug:      Add debugging flags as specified in DEBUG_* variables
#-- lto:        Add compile flags for building with link time optimization
#-- autodeps:   Automatically add library dependencies/provides
#
OPTIONS=(strip docs !libtool !staticlibs emptydirs zipman purge !debug lto autodeps)

#-- File integrity checks to use. Valid: ck, md5, sha1, sha224, sha256, sha384, sha512, b2
INTEGRITY_CHECK=(sha256)

#-- Options to be used when stripping binaries. See `man strip' for details.
STRIP_BINARIES="--strip-all"

#-- Options to be used when stripping shared libraries. See `man strip' for details.
STRIP_SHARED="--strip-unneeded"

#-- Options to be used when stripping static libraries. See `man strip' for details.
STRIP_STATIC="--strip-debug"

#-- Manual (man and info) directories to compress (if zipman is specified)
MAN_DIRS=({usr{,/local}{,/share},opt/*}/{man,info})

#-- Doc directories to remove (if !docs is specified)
DOC_DIRS=(usr/{,local/}{,share/}{doc,gtk-doc} opt/*/{doc,gtk-doc})

#-- Library directories used by autodeps
LIB_DIRS=(lib:usr/lib)

#-- Files to be removed from all packages (if purge is specified)
PURGE_TARGETS=(usr/{,share}/info/dir .packlist *.pod)

#-- Directory to store source code in for debug packages
DBGSRCDIR="/usr/src/debug"

#########################################################################
# PACKAGE OUTPUT
#########################################################################
#
# Default: put built package and cached source in build directory
#
#-- Destination: specify a fixed directory where all packages will be placed
PKGDEST="${HOME}/.cache/makepkg/pkg"

#-- Source cache: specify a fixed directory where source files will be cached
SRCDEST="${HOME}/.cache/makepkg/src"

#-- Source packages: specify a fixed directory where all src packages will be placed
SRCPKGDEST="${HOME}/.cache/makepkg/srcpkg"

#-- Log files: specify a fixed directory where all log files will be placed
LOGDEST="${HOME}/.cache/makepkg/log"

#-- Packager: name/email of the person or organization building packages
#PACKAGER="John Doe <john@doe.com>"

#-- Specify a key to use for package signing
#GPGKEY=""

#########################################################################
# COMPRESSION DEFAULTS
#########################################################################
#
# These affect package creation time and package size, not runtime speed.
# Avoid --best for local optimized builds unless disk size matters more than
# build speed.
#
COMPRESSGZ=(pigz -c -f -n)
COMPRESSBZ2=(pbzip2 -c -f)
COMPRESSXZ=(xz -c -z --threads=0 -)
COMPRESSZST=(zstd -c -T0 -)
COMPRESSLRZ=(lrzip -q)
COMPRESSLZO=(lzop -q)
COMPRESSZ=(compress -c -f)
COMPRESSLZ4=(lz4 -q)
COMPRESSLZ=(plzip -c -f)

#########################################################################
# EXTENSION DEFAULTS
#########################################################################
#
PKGEXT='.pkg.tar.zst'
SRCEXT='.src.tar.zst'

#########################################################################
# OTHER
#########################################################################
#
#-- Command used to run pacman as root, instead of trying sudo and su
PACMAN_AUTH=(sudo-rs)
