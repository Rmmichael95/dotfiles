# ~/.config/uwsm/env
# Sourced by UWSM for all compositors. Shell-evaluated (export syntax works).
# These become available to all systemd user units after UWSM starts.

# ── Default Programs ──────────────────────────────────────────────────────
# These must reach the systemd session so that apps launched via
# uwsm app --, D-Bus activation, and desktop portals all agree on defaults.
export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='nvim +Man!'
export MANPAGER='nvim +Man!'
export TERMINAL='ghostty'
export BROWSER='floorp'
export BROWSERCLI='w3m'
export READER='zathura'
export IMAGEVIEWER='nsxiv'
export VIDEOPLAYER='mpv'
export FILE='yazi'
export COLORTERM='truecolor'
export OPENER='xdg-open'

# ── Locale ────────────────────────────────────────────────────────────────
export LANG='en_US.UTF-8'
export LC_COLLATE='C'

# ── Toolchain Homes ───────────────────────────────────────────────────────
# Needed when dev tools are launched from terminal emulators in the session.
# Keeps tools finding their data/config even when started via systemd units.
export CARGO_HOME="$HOME/.local/share/cargo"
export RUSTUP_HOME="$HOME/.local/share/rustup"
export GOPATH="$HOME/.local/share/go"
export GOMODCACHE="$HOME/.local/cache/go/mod"
export NVM_DIR="$HOME/.local/share/nvm"
export NPM_CONFIG_CACHE="$HOME/.local/cache/npm"
export NPM_CONFIG_USERCONFIG="$HOME/.config/npm/npmrc"
export DOTNET_CLI_HOME="$HOME/.local/share/dotnet"

# ── Python / Perl ─────────────────────────────────────────────────────────
export PYTHONSTARTUP="$HOME/.config/python/pythonrc"
export PYTHONHISTFILE="$HOME/.local/state/python/history"
export PERL_LOCAL_LIB_ROOT="$HOME/.local/share/perl5"
export PERL5LIB="$HOME/.local/share/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"

# ── XDG-Compliant App Paths ───────────────────────────────────────────────
export WGETRC="$HOME/.config/wget/wgetrc"
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"
export NOTMUCH_CONFIG="$HOME/.config/notmuch-config"
export MBSYNCRC="$HOME/.config/mbsync/config"
export ANSIBLE_CONFIG="$HOME/.config/ansible/ansible.cfg"
export WINEPREFIX="$HOME/.local/share/wineprefixes/default"
export CUDA_CACHE_PATH="$HOME/.local/cache/nv"
export NOTES_DIR="$HOME/documents/batcave/notes"
export MAKEPKG_CONF="$HOME/.config/pacman/makepkg.conf"

# ── Privilege Escalation ─────────────────────────────────────────────────
export SUDO_ASKPASS="$HOME/.local/bin/myBin/menu/menuaskpass"

# ── Build Flags ───────────────────────────────────────────────────────────
export MAKEFLAGS="-j$(nproc)"
export ARCHFLAGS="-arch x86_64"

# ── Behavior ─────────────────────────────────────────────────────────────
export WINEFSYNC=1
export MAILSYNC_MUTE=1
export NIXPKGS_ALLOW_UNFREE=1
export LIBSEAT_BACKEND='logind'
export LESS='-R'
export LESSHISTFILE='-'

# .NET / C# IDE integration
export OMNISHARPHOME="$HOME/.config/omnisharp"

# Julia — if launching from graphical IDE
export JULIA_DEPOT_PATH="$HOME/.local/share/julia:$JULIA_DEPOT_PATH"

# DB tool history — useful for IDE database clients
export SQLITE_HISTORY="$HOME/.local/state/sqlite_history"
export MYSQL_HISTFILE="$HOME/.local/state/mysql_history"

# Perl build flags — needed if installing Perl modules from GUI tools
export PERL_MB_OPT="--install_base \"$HOME/.local/share/perl5\""
export PERL_MM_OPT="INSTALL_BASE=$HOME/.local/share/perl5"
